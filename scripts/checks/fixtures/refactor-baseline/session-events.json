  "scenarios": [
    {
      "id": "codex-read-complete-restart",
      "kind": "codex",
      "session": "synthetic-codex",
      "actions": [
        {
          "op": "event",
          "at": 1,
          "event": "working",
          "expect": {
            "exists": true,
            "state": "working",
            "indicator": "running"
          }
        },
        {
          "op": "capture",
          "at": 1.1,
          "capture": "running"
        },
        {
          "op": "open",
          "at": 2,
          "capture": "running",
          "expect": {
            "exists": true,
            "state": "working",
            "indicator": "running"
          }
        },
        {
          "op": "event",
          "at": 3,
          "event": "working",
          "expect": {
            "exists": true,
            "state": "working",
            "indicator": "running"
          }
        },
        {
          "op": "open",
          "at": 3.5,
          "capture": "running",
          "expect": {
            "exists": true,
            "state": "working",
            "indicator": "running"
          }
        },
        {
          "op": "event",
          "at": 4,
          "event": "done",
          "expect": {
            "exists": true,
            "state": "done",
            "indicator": "unread",
            "unread": true
          }
        },
        {
          "op": "prune",
          "at": 100,
          "expect": {
            "exists": true,
            "state": "done",
            "indicator": "unread",
            "unread": true
          }
        },
        {
          "op": "capture",
          "at": 100.1,
          "capture": "completion"
        },
        {
          "op": "restart",
          "at": 100.5,
          "expect": {
            "exists": true,
            "state": "done",
            "indicator": "unread",
            "unread": true
          }
        },
        {
          "op": "open",
          "at": 101,
          "capture": "completion",
          "expect": {
            "exists": true,
            "state": "done",
            "indicator": "read",
            "unread": false
          }
        },
        {
          "op": "prune",
          "at": 132,
          "expect": {
            "exists": true,
            "state": "idle",
            "indicator": "read",
            "unread": false
          }
        },
        {
          "op": "prune",
          "at": 800,
          "expect": {
            "exists": false
          }
        }
      ]
    },
